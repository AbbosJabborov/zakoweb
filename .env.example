# Zakoweb Environment Variables (Example)
DEBUG=False
SECRET_KEY=change_this_to_a_secure_random_secret_key

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL)
POSTGRES_DB=zakoweb_db
POSTGRES_USER=zakoweb_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# AI Agent Configuration (Google Gemini Studio)
GEMINI_API_KEY=your_gemini_api_key_here
